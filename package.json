{
  "name": "bob-cloud-codegen",
  "version": "0.1.0",
  "description": "IBM Bob cloud code generator mode — event-driven Python source generation",
  "bin": {
    "bob-cloud-codegen": "scripts/install.mjs"
  },
  "main": "scripts/install.mjs",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".bob/custom_modes.yaml",
    ".bob/hooks",
    ".bob/mcp.json.example",
    ".bob/rules-cloud-codegen",
    ".bob/rules-code-reviewer",
    ".bob/settings.json",
    ".bob/skills",
    "AGENTS.md",
    "skills-lock.json",
    "specs",
    "scripts"
  ],
  "scripts": {
    "install-mode": "node scripts/install.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "keywords": [
    "bob",
    "ibm-bob",
    "claude",
    "ai-agent",
    "cloud",
    "python",
    "codegen",
    "event-driven"
  ],
  "license": "MIT"
}
